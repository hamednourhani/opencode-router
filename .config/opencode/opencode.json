{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-v4-pro",
    "small_model": "deepseek/deepseek-v4-pro",
    "default_agent": "router",
    "subagent_depth": 1,
    "mcp": {
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "/home/hnourhani/.local/bin/codebase-memory-mcp"
            ]
        },
        "firebase": {
            "type": "local",
            "command": ["npx", "-y", "firebase-tools@latest", "mcp"],
            "enabled": true
        }
    },
    "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "todowrite": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": { "*": "ask" },
        "webfetch": "ask",
        "external_directory": {
            "*": "ask",
            "/home/hnourhani/Workspace/mo/**": "allow",
            "/home/hnourhani/Workspace/mo-development-env/**": "allow",
            "/tmp/**": "allow"
        }
    },
    "provider": {
        "opencode-zen": {
            "options": {
                "apiKey": "{env:OPENCODE_API_KEY}"
            }
        },
        "deepseek": {
            "options": {
                "apiKey": "{env:DEEPSEEK_API_KEY}"
            }
        }
    },
    "agent": {
        "router":    { "model": "deepseek/deepseek-v4-pro" },
        "architect": { "model": "opencode/minimax-m3" },
        "developer": { "model": "deepseek/deepseek-v4-pro" },
        "reviewer":  { "model": "opencode/qwen3.6-plus" }
    }
}
